# Swapea - Environment Variables Template
# Copy this file to .env and fill in your values for local or production deployment.

# ==========================================
# Database Configuration (PostgreSQL / Supabase / Neon)
# ==========================================
# Pooled connection string (used by Prisma Client in serverless environments)
DATABASE_URL="postgresql://postgres:password@localhost:5432/swapea?schema=public&sslmode=prefer"
# Direct connection string (used by Prisma CLI for migrations)
DIRECT_URL="postgresql://postgres:password@localhost:5432/swapea?schema=public"

# ==========================================
# Authentication (NextAuth.js)
# ==========================================
NEXTAUTH_SECRET="your-super-secret-random-32-character-key"
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ==========================================
# Real-Time Messaging (Pusher)
# ==========================================
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="mt1"

NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# ==========================================
# Media & Cloud Storage (Cloudinary)
# ==========================================
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# ==========================================
# Public App Settings
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
